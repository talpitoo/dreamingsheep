    "googleapis": "105.0.0",
    "gray-matter": "4.0.3",
    "lodash": "4.17.21",
    "luxon": "3.0.3",
    "moment": "2.29.4",
    "next": "13.4.5",
    "postcss": "8.4.27",
    "puppeteer": "17.0.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-google-charts": "4.0.0",
    "react-google-recaptcha-v3": "1.10.1",
    "react-hook-form": "7.34.2",
    "react-uid": "2.3.2",
    "secure-password": "4.0.0",
    "sharp": "0.32.6",
    "swiper": "8.4.5",
    "tailwindcss": "3.2.4",
