    "@types/lodash": "4.14.184",
    "@types/luxon": "3.0.0",
    "@types/preview-email": "2.0.1",
    "@types/react": "18.2.18",
    "@types/react-dom": "18.2.7",
    "@types/uuid": "8.3.4",
    "@typescript-eslint/eslint-plugin": "6.2.1",
    "eslint": "7.x",
    "eslint-config-next": "13.4.12",
    "eslint-config-prettier": "8.10.0",
    "husky": "8.0.1",
    "lint-staged": "13.0.3",
    "prettier": "2.7.1",
    "prettier-plugin-prisma": "4.2.0",
    "pretty-quick": "3.1.3",
