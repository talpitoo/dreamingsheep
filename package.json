{
  "name": "dreamingsheep",
  "version": "3.1.3",
  "keywords": [
    "BlitzJS",
    "Prisma",
    "Postgres"
  ],
  "description": "The frontend of dreamingsheep",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/talpitoo/dreamingsheep.git"
  },
  "engines": {
    "node": "18"
  },
  "author": "the dreamingsheep team",
  "contributors": [
    {
      "name": "Rachel Purba",
      "url": "https://github.com/rachelpurba"
    },
    {
      "name": "Laslo Antal",
      "url": "https://lasloantal.com/"
    },
    {
      "name": "Heber Nobre",
      "url": "https://github.com/zbrukas"
    },
    {
      "name": "Adam Shovav",
      "url": "https://github.com/adamshovav"
    },
    {
      "name": "Tóth Tamás",
      "url": "https://talpitoo.com/"
    }
  ],
  "scripts": {
    "dev": "blitz dev",
    "build": "blitz build",
    "start": "blitz start",
    "studio": "blitz prisma studio",
    "lint": "eslint --ignore-path .gitignore --ext .js,.ts,.tsx .",
    "prepare": "husky install",
    "type:check": "tsc --noEmit"
  },
  "prisma": {
    "schema": "db/schema.prisma"
